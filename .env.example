# Variables del blog. Se leen al compilar desde el ENTORNO (terminal o GitHub Actions), no desde un
# archivo .env: Vite solo inyecta esos archivos en el código del navegador. Ver docs/blog-wordpress.md.
# No es secreta: el blog usa solo la API pública de WordPress (artículos publicados).
#
# PowerShell:  $env:WP_API_URL = "https://cms.plagastop.cl/wp-json/wp/v2"; npm run build
# Bash:        WP_API_URL=https://cms.plagastop.cl/wp-json/wp/v2 npm run build

# Raíz de la API REST de WordPress. Si se define, sus artículos se publican junto con los del sitio.
WP_API_URL=
