# Plagastop · /api: solo se publica enviar.php y se ejecuta como PHP.
# Las reglas de reescritura del sitio (si existen en public_html/.htaccess) no se aplican aquí,
# así el endpoint nunca se redirige al HTML de React Router.

<IfModule mod_rewrite.c>
  RewriteEngine Off
</IfModule>

Options -Indexes
DirectoryIndex enviar.php

# Todo lo demás de esta carpeta (biblioteca, catálogo de opciones, error_log) queda bloqueado.
<IfModule mod_authz_core.c>
  Require all denied
  <Files "enviar.php">
    Require all granted
  </Files>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <Files "enviar.php">
    Order allow,deny
    Allow from all
  </Files>
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
